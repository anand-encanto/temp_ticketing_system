          "name": "Admin Ticket Details - additive fields check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const ticket = json && json.data;",
                  "",
                  "pm.test('Ticket detail has additive frontend URL and KPI/SLA keys', function () {",
                  "    pm.expect(ticket).to.be.an('object');",
                  "    pm.expect(ticket).to.have.property('frontend_ticket_url');",
                  "    pm.expect(ticket.frontend_ticket_url).to.include('/dashboard/tickets/');",
                  "    pm.expect(ticket).to.have.property('post_assignment_sla_status');",
                  "    pm.expect(ticket).to.have.property('technician_resolution_minutes');",
                  "    pm.expect(ticket).to.have.property('ticket_lifecycle_minutes');",
                  "});"
                ]
