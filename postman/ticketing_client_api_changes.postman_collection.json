      "item": [
        {
          "name": "Admin Ticket List - additive fields check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const firstTicket = json && json.data && json.data.data && json.data.data[0];",
                  "",
                  "if (firstTicket) {",
                  "    pm.collectionVariables.set('ticket_id', firstTicket.id);",
                  "}",
                  "",
                  "pm.test('First ticket has additive frontend URL and KPI/SLA keys', function () {",
                  "    pm.expect(firstTicket).to.be.an('object');",
                  "    pm.expect(firstTicket).to.have.property('frontend_ticket_url');",
                  "    pm.expect(firstTicket).to.have.property('post_assignment_sla_status');",
                  "    pm.expect(firstTicket).to.have.property('technician_resolution_minutes');",
                  "    pm.expect(firstTicket).to.have.property('ticket_lifecycle_minutes');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ticket_system_live}}api/admin/ticket/list?page=1&per_page={{per_page}}",
              "host": [
                "{{ticket_system_live}}api"
              ],
              "path": [
                "admin",
                "ticket",
                "list"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "{{per_page}}"
                }
              ]
            }
          },
          "response": []
        },
